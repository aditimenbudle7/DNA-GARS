# Normalize line endings across Windows/Linux/macOS
* text=auto

*.c       text eol=lf
*.h       text eol=lf
*.py      text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.csv     text eol=lf
*.fa      text eol=lf
*.fasta   text eol=lf
Makefile  text eol=lf
*.sh      text eol=lf

# Binary files
*.png     binary
*.jpg     binary
*.pdf     binary
